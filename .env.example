# Gemini API key (server-side only if AI features are enabled)
GEMINI_API_KEY=

# Deployment mode: 'public-playground' (anonymous short-lived playground tokens)
# or 'production-private' (mandatory API key authentication + fail-closed OS sandbox)
POWERSCRIPT_DEPLOYMENT_MODE=public-playground

# Server-side HMAC session secret (minimum 32 random chars in production-private)
POWERSCRIPT_SESSION_SECRET=

# Mandatory master API key for 'production-private' deployments (minimum 16 random chars)
POWERSCRIPT_API_KEY=

# Optional comma-separated list of trusted reverse-proxy IPs or CIDRs (e.g. "127.0.0.1,10.0.0.0/8" or "loopback").
# Leave empty when exposed directly so client-supplied X-Forwarded-For / X-Forwarded-Host headers are never trusted.
POWERSCRIPT_TRUSTED_PROXIES=

# Optional override to permit degraded isolation when OS namespaces/prlimit/setpriv are unavailable (NOT recommended for production)
POWERSCRIPT_ALLOW_DEGRADED_SANDBOX=false
