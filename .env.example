# Gemini API key (server-side only if AI features are enabled)
GEMINI_API_KEY=

# Optional PowerScript Sandbox Server configuration (uncomment for custom/private deployments):
# POWERSCRIPT_DEPLOYMENT_MODE=public-playground
# POWERSCRIPT_SESSION_SECRET=<minimum-32-char-random-secret>
# POWERSCRIPT_API_KEY=<minimum-16-char-random-api-key>
# POWERSCRIPT_TRUSTED_PROXIES=127.0.0.1
# POWERSCRIPT_ALLOW_DEGRADED_SANDBOX=false
